<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/biblium_background"
    tools:context=".ui.fragments.auth.LoginFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        >

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="355dp"
            android:layout_height="240dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/logo_biblium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/etUser"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:background="@drawable/glow_input_bg"
            android:hint="@string/usuario"
            android:textColorHint="@color/text_input_login"
            android:textColor="@color/white"
            android:paddingStart="24dp"
            android:layout_marginTop="40dp"
            android:elevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:background="@drawable/glow_input_bg"
            android:hint="@string/contrase_a"
            android:inputType="textPassword"
            android:textColorHint="#B0C4C4"
            android:textColor="@color/white"
            android:paddingStart="24dp"
            android:layout_marginTop="20dp"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/etUser"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEnter"
            style="@style/Widget.Button.Primary"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/entrar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPassword" />
            />

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contrase_a_olvidada"
            android:textColor="#B0C4C4"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnEnter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>