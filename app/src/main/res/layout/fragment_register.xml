<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/biblium_background"
    tools:context=".ui.fragments.auth.LoginFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        >
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="355dp"
            android:layout_height="240dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/logo_biblium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <EditText
            android:id="@+id/etrUserName"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/glow_input_bg"
            android:elevation="8dp"
            android:hint="@string/name"
            android:inputType=""
            android:paddingStart="24dp"
            android:textColor="@color/white"
            android:textColorHint="#B0C4C4"
            app:layout_constraintBottom_toTopOf="@+id/etrEmail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etrEmail"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="204dp"
            android:background="@drawable/glow_input_bg"
            android:elevation="6dp"
            android:hint="Email"
            android:paddingStart="24dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_input_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <EditText
            android:id="@+id/etrPassword"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/glow_input_bg"
            android:elevation="8dp"
            android:hint="@string/contrase_a"
            android:inputType="textPassword"
            android:paddingStart="24dp"
            android:textColor="@color/white"
            android:textColorHint="#B0C4C4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etrEmail" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            style="@style/Widget.Button.Primary"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/registrar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etrPassword" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>