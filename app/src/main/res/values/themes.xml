<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Biblium" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:windowBackground">#FDFBEA</item>
        <item name="colorOnSurface">#444444</item>
        <item name="colorPrimary">@color/name2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#B8C4C0</item>
        <item name="colorOnSecondary">#444444</item>
        <item name="colorSurface">#E0E0E0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="editTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.Biblium" parent="Base.Theme.Biblium" />

    <style name="Widget.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_ppal</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#DAFFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">1.2</item>
        <item name="android:shadowDy">1.2</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="RoundedCorners" parent="">
        <item name="cornerSize">22dp</item>
        <item name="cornerFamily">rounded</item>
    </style>
</resources>